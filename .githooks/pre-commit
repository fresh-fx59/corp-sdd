#!/usr/bin/env bash
# pre-commit — auto-bump the version of every staged command, skill, or script,
# then refresh VERSIONS.md and restage. No prompting: an edit IS a new version.
# Deletions are ignored. CORP_SDD_NO_BUMP=1 skips the bump; CORP_SDD_BUMP_LEVEL=minor|major
# raises the level for this commit. bash 3.2 compatible (no mapfile).
set -uo pipefail
[ "${CORP_SDD_NO_BUMP:-0}" = "1" ] && exit 0
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1
staged_list="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$staged_list" ] && exit 0
case "${CORP_SDD_BUMP_LEVEL:-patch}" in
  major) flag=--major ;;
  minor) flag=--minor ;;
  *)     flag=--bump ;;
esac
set -- "$flag"
while IFS= read -r f; do [ -n "$f" ] && set -- "$@" "$f"; done <<<"$staged_list"
node tools/versions.mjs "$@" || exit 1
node tools/versions.mjs --manifest >/dev/null || exit 1
while IFS= read -r f; do [ -f "$f" ] && git add -- "$f"; done <<<"$staged_list"
[ -f VERSIONS.md ] && git add -- VERSIONS.md
node tools/versions.mjs --check || exit 1
